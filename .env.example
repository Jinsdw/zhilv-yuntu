# 智旅云图环境变量模板

# 项目配置
PROJECT_NAME=智旅云图
DEBUG=true

# 高德地图 API Key
AMAP_API_KEY=5438fb4d2e66f6bddb30d6d2cfb59dc3
AMAP_JS_API_KEY=5438fb4d2e66f6bddb30d6d2cfb59dc3

# 智谱大模型 API
ZHIPU_API_KEY=你的智谱API_KEY
ZHIPU_MODEL=glm-4.6v-FlashX

# LLM API 配置
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Embedding 配置
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=你的智谱API_KEY
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Rerank 模型
RERANK_MODEL=rerank

# ChromaDB 路径
CHROMA_DB_PATH=./data/chroma_db

# SQLite 数据库路径
DATABASE_URL=sqlite+aiosqlite:///./data/trips.db

# 缓存配置 (false = 不使用Redis)
CACHE_ENABLED=false

# 攻略文档路径
GUIDE_DOCS_PATH=./data/guides

# 日志级别
LOG_LEVEL=INFO
