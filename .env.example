# 智旅云图环境变量模板

# 项目配置
PROJECT_NAME=智旅云图
DEBUG=true

# 高德地图 API Key
AMAP_API_KEY=5438fb4d2e66f6bddb30d6d2cfb59dc3
AMAP_JS_API_KEY=5438fb4d2e66f6bddb30d6d2cfb59dc3

# 大模型平台切换（控制所有对话/生成类 LLM 调用）：zhipu（智谱）| packycode
LLM_PROVIDER=zhipu

# 平台一：智谱大模型 API
ZHIPU_API_KEY=你的智谱API_KEY
ZHIPU_MODEL=glm-4.6v-FlashX
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 平台二：packycode（OpenAI 兼容端点；LLM_PROVIDER=packycode 时生效）
PACKY_API_KEY=你的packycode API_KEY
PACKY_MODEL=deepseek-v4-flash
PACKY_BASE_URL=https://www.packyapi.com/v1

# Embedding 配置
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=你的智谱API_KEY
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Rerank 模型
RERANK_MODEL=rerank

# ChromaDB 路径
CHROMA_DB_PATH=./data/chroma_db

# SQLite 数据库路径
DATABASE_URL=sqlite+aiosqlite:///./data/trips.db

# 缓存配置 (false = 不使用Redis)
CACHE_ENABLED=false

# Redis 连接地址（Docker 部署时由 docker-compose.yaml 固定为 redis://redis:6379/0；
# 本地开发如需 Redis 缓存可设为 redis://localhost:6379/0）
REDIS_URL=redis://localhost:6379/0

# 攻略文档路径
GUIDE_DOCS_PATH=./data/guides

# 日志级别
LOG_LEVEL=INFO

# CORS 来源白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AMap JS API security code (required by JSAPI v2.0, fill from AMap console)
AMAP_SECURITY_JS_CODE=
